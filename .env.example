# Debian Observatory — Environment Configuration
# Copy to .env and customize. All variables are optional.

# UDD Data Source (PostgreSQL)
# UDD_HOST=udd-mirror.debian.net
# UDD_PORT=5432
# UDD_DATABASE=udd
# UDD_USER=udd-mirror
# UDD_PASSWORD=***

# API Service
# API_HOST=127.0.0.1
# API_PORT=8000
# PARQUET_DIR=data/parquet
